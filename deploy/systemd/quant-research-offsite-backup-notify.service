[Unit]
Description=Quant Research offsite backup failure notification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/quant-research/notifications.env
ExecStart=/usr/bin/python3 /home/bruno/apps/quant-research-platform/deploy/notifications/send_refresh_failure.py --service-unit quant-research-offsite-backup.service
TimeoutStartSec=45s
